# Copy this file to .env and fill in real values. Never commit .env itself.

# Your MongoDB Atlas connection string (see README.md for how to get one)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/numerology?retryWrites=true&w=majority

# Port the server listens on (most hosts set this automatically — leave as-is)
PORT=3000

# YouTube Data API v3 key — needed for the driver/conductor number video
# recommendations. Get a free one at console.cloud.google.com:
# 1. Create a project (or use an existing one)
# 2. APIs & Services > Library > search "YouTube Data API v3" > Enable
# 3. APIs & Services > Credentials > Create Credentials > API key
# 4. (Recommended) restrict the key to "YouTube Data API v3" only
YOUTUBE_API_KEY=

# Admin panel (book library management) — visit /admin.html to log in.
# Pick your own password. SESSION_SECRET can be any random string (used to
# sign login sessions) — e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
SESSION_SECRET=
